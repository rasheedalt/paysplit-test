    "demo": "npm run build && node dist/scripts/demo.js"
  },
  "dependencies": { "express": "5.1.0" },
  "devDependencies": {
    "@types/express": "5.0.4",
    "@types/node": "24.9.1",
    "typescript": "5.9.3"
  }
}
