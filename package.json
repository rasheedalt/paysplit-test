{
  "name": "paysplit-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "worker": "node --env-file-if-exists=.env dist/src/worker.js",
    "test": "npm run build && node --test dist/tests/integration/*.test.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env dist/scripts/prepareDatabase.js",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "5.1.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.4",
    "@types/node": "24.9.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "3.3.2",
    "prisma": "^6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
